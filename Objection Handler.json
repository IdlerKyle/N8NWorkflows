    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output;\n\nconst match = output.match(/\\[DATA\\](.*?)\\[\\/DATA\\]/);\n\nif (match) {\n  const data = JSON.parse(match[1]);\n  return [{\n    json: {\n      name: data.name,\n      email: data.email,\n      objection_type: data.objection_type,\n      summary: data.summary,\n      full_response: output.replace(/\\[DATA\\].*?\\[\\/DATA\\]/, '').trim(),\n      timestamp: new Date().toISOString()\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    name: null,\n    email: null,\n    objection_type: null,\n    summary: null,\n    full_response: output,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
