    {
      "parameters": {
        "jsCode": "const orderJsonKeys = (obj) => {\n  return Object.keys(obj)\n    .sort()\n    .reduce((acc, key) => {\n      acc[key] = obj[key];\n      return acc;\n    }, {});\n};\n\nconst githubItem = $input.all()[0].json;\nconst workflowItem = $input.all()[1].json;\n\n// If GitHub returned a file\nif (githubItem.content || githubItem.data) {\n\n  const decoded = githubItem.content\n    ? JSON.parse(Buffer.from(githubItem.content, \"base64\").toString())\n    : JSON.parse(githubItem.data);\n\n  const orderedOriginal = orderJsonKeys(decoded);\n  const orderedActual = orderJsonKeys(workflowItem);\n\n  if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n    githubItem.github_status = \"same\";\n  } else {\n    githubItem.github_status = \"different\";\n    githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n\n  githubItem.content_decoded = orderedOriginal;\n\n} else {\n\n  // File does not exist in GitHub\n  const orderedActual = orderJsonKeys(workflowItem);\n\n  githubItem.github_status = \"new\";\n  githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\nreturn $input.all();"
      },
