    {
      "parameters": {
        "jsCode": "// Validate incoming lead and compute a simple lead score.\nconst item = $input.first().json;\nconst body = item.body || item;\n\nconst name = (body.name || '').trim();\nconst email = (body.email || '').trim();\nconst phone = (body.phone || '').trim();\nconst loanAmount = Number(body.loanAmount || 0);\nconst message = (body.message || '').trim();\n\nconst errors = [];\nif (!name) errors.push('Missing name');\nif (!email || !email.includes('@')) errors.push('Invalid or missing email');\nif (!phone) errors.push('Missing phone');\n\n// Lead scoring: higher score = hotter lead.\nlet score = 0;\nif (loanAmount >= 50000) score += 50;\nelse if (loanAmount >= 10000) score += 30;\nelse if (loanAmount > 0) score += 10;\nif (phone) score += 20;\nif (message.length > 20) score += 15;\nif (email.includes('@')) score += 15;\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    score,\n    priority: score >= 70 ? 'HOT' : score >= 40 ? 'WARM' : 'COLD',\n    lead: { name, email, phone, loanAmount, message, receivedAt: new Date().toISOString() }\n  }\n}];"
      },
      "id": "fbd16859-f4ee-45ff-817a-f956a92cbca2",
      "name": "Validate & Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
