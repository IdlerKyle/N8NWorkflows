      "typeVersion": 1.1,
      "position": [
        208,
        208
      ],
      "id": "4b7bcc3c-9b4b-4fcf-accc-f34dfcd64598",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "0sicXWlefaiG04U7",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const text = item.json.output || \"\";\n\n  const parsed = {};\n\n  const scoreMatch = text.match(/\\*{0,2}Score:?\\*{0,2}\\s*(\\d+)\\s*\\/\\s*(\\d+)/i);\n  if (scoreMatch) {\n    parsed.score = parseInt(scoreMatch[1]);\n    parsed.score_max = parseInt(scoreMatch[2]);\n  }\n\n  const categoryMatch = text.match(/\\*{0,2}Category:?\\*{0,2}\\s*(.+)/i);\n  if (categoryMatch) {\n    parsed.category = categoryMatch[1].trim().replace(/\\*/g, \"\");\n  }\n\n  const explanationMatch = text.match(/\\*{0,2}Explanation:?\\*{0,2}\\s*\\n([\\s\\S]+)/i);\n  if (explanationMatch) {\n    parsed.explanation = explanationMatch[1].trim();\n  }\n\n  results.push({ json: parsed });\n}\n\nreturn results;"
      },
