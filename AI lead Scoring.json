        "text": "={{ $json.body }}",
        "options": {
          "systemMessage": "\"Here's a lead that just submitted a form. Score them 0 to 100 based on how likely they are to become a paying customer. Consider how detailed their answers are, whether they mentioned a budget or timeline, and how urgent they seem. Return the score, a category (hot, warm, cold, or unqualified), and a short explanation of why.\""
        }
