    {
      "parameters": {
        "jsCode": "const orderJsonKeys = (obj) => {\n  return Object.keys(obj)\n    .sort()\n    .reduce((acc, key) => {\n      acc[key] = obj[key];\n      return acc;\n    }, {});\n};\n\n// Read the GitHub API response directly — it always has sha intact.\n// We can NOT rely on $input.all()[0] for sha because when \"If file too large\"\n// routes through \"Get File\" (HTTP download), the raw downloaded JSON replaces\n// the API response and sha is lost from the merged item.\nconst githubApiResponse = $('Get file data').first().json;\n\nconst githubMergedItem = $input.all()[0].json;\nconst workflowItem     = $input.all()[1].json;\n\n// Strip fields the Config node injected so only the raw n8n workflow is stored/compared\nconst configFields = new Set(['repo_owner', 'repo_name', 'repo_path']);\nconst workflowData = Object.fromEntries(\n  Object.entries(workflowItem).filter(([k]) => !configFields.has(k))\n);\nconst orderedActual = orderJsonKeys(workflowData);\n\n// Build a fresh output object — avoids n8n mutation quirks on $input items\nconst resultGithub = { ...githubMergedItem };\n\nif (githubApiResponse.sha) {\n  // File exists in GitHub — decode its content for comparison\n  let decoded = null;\n\n  if (githubApiResponse.content) {\n    // Normal case: content is base64-encoded inline in the API response\n    try {\n      decoded = JSON.parse(\n        Buffer.from(githubApiResponse.content, 'base64').toString('utf8')\n      );\n    } catch(e) {}\n  } else {\n    // Large file (>1 MB): content was fetched by \"Get File\" and is the\n    // parsed JSON already sitting in input[0] — detected by presence of .nodes\n    if (githubMergedItem && typeof githubMergedItem === 'object' && githubMergedItem.nodes) {\n      decoded = githubMergedItem;\n    }\n  }\n\n  if (decoded) {\n    const orderedOriginal = orderJsonKeys(decoded);\n    if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n      resultGithub.github_status = 'same';\n    } else {\n      resultGithub.github_status = 'different';\n      resultGithub.sha = githubApiResponse.sha; // needed by the Edit node\n      resultGithub.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n    }\n  } else {\n    // Could not decode — force an update to be safe\n    resultGithub.github_status = 'different';\n    resultGithub.sha = githubApiResponse.sha;\n    resultGithub.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n} else {\n  // No sha in the API response — file does not exist in GitHub yet\n  resultGithub.github_status = 'new';\n  resultGithub.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\n// Return explicitly constructed items — never mutate-and-return $input.all()\nreturn [\n  { json: resultGithub },\n  { json: workflowItem }\n];"
      },
