    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst total = items.length;\n\nconst succeeded = items.filter(r => r.status !== 'failed');\nconst failed = items.filter(r => r.status === 'failed');\n\nconst successLines = succeeded.map(r => `• ${r.workflow_name} — ${r.status}`);\nconst failureLines = failed.map(r => `⚠ ${r.workflow_name} — ${r.error}`);\n\nconst body = [\n  `✅ Backup complete — ${total} workflows processed.`,\n  ``,\n  `Succeeded: ${succeeded.length}`,\n  `Failed:    ${failed.length}`,\n  ``,\n  ...(successLines.length ? ['Backed up:', ...successLines, ''] : []),\n  ...(failureLines.length ? ['Failures:', ...failureLines] : [])\n].join('\\n');\n\nreturn [{\n  json: {\n    subject: `Backup complete — ${total} workflows (${failed.length} failed)`,\n    body: body,\n    total: total,\n    succeeded: succeeded.length,\n    failed: failed.length\n  }\n}];"
      },
