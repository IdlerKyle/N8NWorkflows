    {
      "parameters": {
        "jsCode": "const orderJsonKeys = (obj) => {\n  return Object.keys(obj)\n    .sort()\n    .reduce((acc, key) => {\n      acc[key] = obj[key];\n      return acc;\n    }, {});\n};\n\nconst githubItem = $input.all()[0].json;\nconst workflowItem = $input.all()[1].json;\n\n// Strip fields added by the Config node so we only store/compare the raw n8n workflow\nconst configFields = new Set(['repo_owner', 'repo_name', 'repo_path']);\nconst workflowData = Object.fromEntries(\n  Object.entries(workflowItem).filter(([k]) => !configFields.has(k))\n);\nconst orderedActual = orderJsonKeys(workflowData);\n\n// Check if file exists in GitHub (has sha means it exists)\nif (githubItem.sha) {\n\n  let decoded;\n  if (githubItem.content) {\n    decoded = JSON.parse(Buffer.from(githubItem.content, \"base64\").toString());\n  } else if (githubItem.data) {\n    decoded = JSON.parse(githubItem.data);\n  }\n\n  if (decoded) {\n    const orderedOriginal = orderJsonKeys(decoded);\n    if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n      githubItem.github_status = \"same\";\n    } else {\n      githubItem.github_status = \"different\";\n      githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n    }\n    githubItem.content_decoded = orderedOriginal;\n  } else {\n    // Has sha but couldn't decode - treat as different\n    githubItem.github_status = \"different\";\n    githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n\n} else {\n  // No sha = file doesn't exist\n  githubItem.github_status = \"new\";\n  githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\nreturn $input.all();"
      },
