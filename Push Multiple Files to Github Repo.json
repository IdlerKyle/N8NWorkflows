    {
      "parameters": {
        "jsCode": "// Pull the backup summary built after the main loop\nconst backupSummary = $('Code in JavaScript').first().json;\n\n// Count how many orphaned files were removed\nlet orphanCount = 0;\ntry {\n  orphanCount = $('Find files to delete').all().filter(i => i.json.has_orphans).length;\n} catch(e) {}\n\nconst lines = [backupSummary.body];\nif (orphanCount > 0) {\n  lines.push('', `Removed: ${orphanCount} orphaned workflow file(s) deleted from GitHub.`);\n} else {\n  lines.push('', 'No orphaned files found.');\n}\n\nreturn [{\n  json: {\n    subject: backupSummary.subject + (orphanCount > 0 ? ` — ${orphanCount} removed` : ''),\n    body: lines.join('\\n')\n  }\n}];"
      },
