    {
      "parameters": {
        "jsCode": "// Get current n8n workflow names from the fetch earlier in this run\nconst n8nWorkflows = $('Fetch all workflows').all().map(i => i.json);\nconst n8nNames = new Set(n8nWorkflows.map(w => w.name));\n\n// GitHub repo file listing — filter to .json files only\nconst githubFiles = $input.all()\n  .map(i => i.json)\n  .filter(f => f && f.type === 'file' && f.name && f.name.endsWith('.json'));\n\n// Any file in GitHub whose name (minus .json) has no matching n8n workflow is orphaned\nconst orphans = githubFiles.filter(f => !n8nNames.has(f.name.slice(0, -5)));\n\nif (orphans.length === 0) {\n  return [{ json: { has_orphans: false, orphan_count: 0 } }];\n}\n\nreturn orphans.map(f => ({\n  json: {\n    name: f.name,\n    path: f.path,\n    sha: f.sha,\n    has_orphans: true,\n    orphan_count: orphans.length\n  }\n}));"
      },
